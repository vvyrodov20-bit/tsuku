# Server-side only. Preserve your current Bot #2 token and chat ID.
TELEGRAM_BOT2_TOKEN=
TELEGRAM_BOT2_CHAT_ID=
TELEGRAM_TIMEZONE=Europe/Moscow

# REQUIRED for durable visitor IDs, message IDs and event deduplication.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Existing KV_REST_API_URL + KV_REST_API_TOKEN are also supported.
TRACKING_NAMESPACE=gamehub:v2

# REQUIRED. Generate a random secret and add it to all three postback URLs.
POSTBACK_SECRET=

# Existing affiliate link, retained from the uploaded project.
ONEWIN_AFFILIATE_URL=https://lkvq.cc/838bfc6f
ONEWIN_CLICK_PARAM=sub1

# Optional overrides. Tower Rush and Ice Fishing also have these defaults in code.
ONEWIN_FALLING_PICKAXE_URL=
ONEWIN_ICE_FISHING_URL=https://lkuf.cc/339b76
ONEWIN_TOWER_RUSH_URL=https://lkuf.cc/6561aa49

# Default: ONE combined visitor card in Bot #2, including conversions.
# true: also maintain ONE conversion card per visitor in the old Bot #1.
TELEGRAM_CONVERSIONS_SEPARATE=false
TELEGRAM_BOT1_TOKEN=
TELEGRAM_BOT1_CHAT_ID=
